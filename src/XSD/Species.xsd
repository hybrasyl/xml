  <!-- A species or body key. Saves store it, so it never changes. It has the same form as an element key. -->
  <xs:simpleType name="SpeciesKey">
    <xs:restriction base="hyb:ElementKey" />
  </xs:simpleType>

  <!-- The origin class of a species (lore data). -->
  <xs:simpleType name="SpeciesOrigin">
    <xs:restriction base="xs:token">
      <xs:enumeration value="Aosda" />
      <xs:enumeration value="Tuatha" />
      <xs:enumeration value="Fanaidhe" />
    </xs:restriction>
  </xs:simpleType>

  <!-- Locked has the value 0, so a species that the loader reads without this attribute is not playable. -->
  <xs:simpleType name="SpeciesPlayerOption">
    <xs:restriction base="xs:token">
      <!-- A player cannot pick it. -->
      <xs:enumeration value="Locked" />
      <!-- A player can pick it when they make a character. -->
      <xs:enumeration value="Starter" />
      <!-- A player can pick it after they unlock it. -->
      <xs:enumeration value="Unlockable" />
      <!-- A parent species: a player picks one of its branches, not the parent. -->
      <xs:enumeration value="ByBranch" />
    </xs:restriction>
  </xs:simpleType>

  <!-- The retail body byte. The retail client does not check the range, so the value is always 0 to 9. -->
  <xs:simpleType name="RetailSkinColor">
    <xs:restriction base="xs:unsignedByte">
      <xs:maxInclusive value="9" />
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="SpeciesNames">
    <xs:attribute name="Singular" type="hyb:String8" use="required" />
    <xs:attribute name="Plural" type="hyb:String8" use="required" />
    <xs:attribute name="Adjective" type="hyb:String8" use="required" />
  </xs:complexType>

  <!-- One pre-coloured sprite set. The client body pack maps Id to its sheets for both genders. -->
  <xs:complexType name="SpeciesBody">
    <!-- Saves store the key. It is unique in the species. -->
    <xs:attribute name="Key" type="hyb:SpeciesKey" use="required" />
    <!-- The wire value. It is unique across all species. -->
    <xs:attribute name="Id" type="xs:unsignedShort" use="required" />
    <!-- The display name. When it is absent, the client shows Key. -->
    <xs:attribute name="Name" type="hyb:String8" use="optional" />
    <!-- Exactly one body in a species is the default. -->
    <xs:attribute name="Default" type="xs:boolean" use="optional" default="false" />
    <xs:attribute name="RetailSkinColor" type="hyb:RetailSkinColor" use="optional" default="0" />
  </xs:complexType>

  <xs:complexType name="SpeciesBodies">
    <xs:sequence>
      <xs:element name="Body" type="hyb:SpeciesBody" minOccurs="1" maxOccurs="unbounded" />
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="Species">
    <xs:sequence>
      <xs:element name="Names" type="hyb:SpeciesNames" minOccurs="1" maxOccurs="1" />
      <xs:element name="Description" type="xs:string" minOccurs="0" maxOccurs="1" />
      <!-- A Starter or Unlockable species has bodies. A Locked or ByBranch species can have none. -->
      <xs:element name="Bodies" type="hyb:SpeciesBodies" minOccurs="0" maxOccurs="1" />
    </xs:sequence>
    <!-- The key. Saves and content use it, so it never changes. -->
    <xs:attribute name="Key" type="hyb:SpeciesKey" use="required" />
    <!-- The wire value. It is unique across all species. -->
    <xs:attribute name="Id" type="xs:unsignedByte" use="required" />
    <xs:attribute name="Origin" type="hyb:SpeciesOrigin" use="required" />
    <xs:attribute name="PlayerOption" type="hyb:SpeciesPlayerOption" use="required" />
    <!-- The key of the parent species. The parent is ByBranch. -->
    <xs:attribute name="BranchOf" type="hyb:SpeciesKey" use="optional" />
    <!-- Element keys. A branch without them takes the values of its parent. -->
    <xs:attribute name="Affinity" type="hyb:ElementKey" use="optional" />
    <xs:attribute name="Resistance" type="hyb:ElementKey" use="optional" />
  </xs:complexType>

  <xs:element name="Species" type="hyb:Species">
    <xs:unique name="SpeciesUniqueBodyKey">
      <xs:selector xpath="hyb:Bodies/hyb:Body" />
      <xs:field xpath="@Key" />
    </xs:unique>
    <xs:unique name="SpeciesUniqueBodyId">
      <xs:selector xpath="hyb:Bodies/hyb:Body" />
      <xs:field xpath="@Id" />
    </xs:unique>
  </xs:element>

</xs:schema>
